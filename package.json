{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "dev": "bun run ./scripts/dev.ts",
    "frontend:dev": "bun --hot src/index.tsx",
    "frontend:build": "bun build ./src/index.html --outdir=./dist/html --sourcemap --target=browser --minify --define:process.env.NODE_ENV='production' --env='BUN_PUBLIC_*'"
  },
  "dependencies": {
    "@ant-design/icons": "5.x",
    "antd": "^5.27.4",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "ini": "^5.0.0",
    "mysql2": "^3.15.1"
  }
}