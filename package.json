{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "bun --hot src/index.tsx",
    "devcontainer:clear_up": "rm -r /php_htdocs/*",
    "devcontainer:build": "bun build ./src/index.html --outdir=/php_htdocs --sourcemap --target=browser --minify --define:process.env.NODE_ENV='development' --env='BUN_PUBLIC_*'",
    "devcontainer:copy_api": "cp -r ./api /php_htdocs",
    "devcontainer:frontend:watch": "bun run chokidar \"src/**/*\" -c \"bun run devcontainer:build\"",
    "devcontainer:api:watch": "bun run chokidar \"api/**/*\" -c \"bun run devcontainer:copy_api\"",
    "devcontainer:watch": "bun run concurrently \"bun run devcontainer:frontend:watch\" \"bun run devcontainer:api:watch\""
  },
  "dependencies": {
    "@ant-design/icons": "5.x",
    "antd": "^5.27.4",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1"
  }
}